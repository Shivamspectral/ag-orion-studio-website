# ---- Database (required) ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- Public site configuration ----
# Canonical production origin (no trailing slash). Used for canonical URLs, sitemap, robots, Open Graph.
NEXT_PUBLIC_SITE_URL=https://example.com
# Public contact addresses shown on the website (leave empty until you have them).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_BUSINESS_EMAIL=
# Optional analytics. Provider: "gtag" (Google Analytics 4) or "plausible". Leave ID empty to disable.
NEXT_PUBLIC_ANALYTICS_PROVIDER=gtag
NEXT_PUBLIC_ANALYTICS_ID=

# ---- Admin (server-only, never exposed to the browser) ----
# The admin dashboard at /admin is disabled unless BOTH values are set.
ADMIN_PASSWORD=
# Long random string used to sign admin session cookies (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=
# Optional: salt used when hashing IP addresses for contact-form rate limiting.
CONTACT_IP_SALT=
